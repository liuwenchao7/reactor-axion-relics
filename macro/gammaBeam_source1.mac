# Source 1: Gamma beam at x=30cm, aimed at LXe TPC center (z=-7.55cm)
# Planar circular source, cone half-angle 18 deg (covers TPC radius 8.25cm)
# FIX: rot2=(0,-1,0) makes the polar axis (rot2 x rot1) point toward -x (detector)
# Previous rot2=(0,1,0) pointed the beam AWAY (+x)!
/gps/particle gamma

# Source geometry: circular plane at (30, 0, -7.55) cm
/gps/pos/type Plane
/gps/pos/shape Circle
/gps/pos/rot1 0 0 1
/gps/pos/rot2 0 -1 0
/gps/pos/centre 30 0 -7.55 cm
/gps/pos/radius 8 cm

# Angular: cone 0~18 deg about -x direction (effectively +/-18 deg)
/gps/ang/type iso
/gps/ang/rot1 0 0 1
/gps/ang/rot2 0 -1 0
/gps/ang/mintheta 0 deg
/gps/ang/maxtheta 18 deg

# Energy spectrum from reactor gamma histogram file
/gps/ene/type Arb
/gps/ene/diffspec 1
/gps/hist/type arb

/control/getEnv GAMMAHIST
/gps/hist/file {GAMMAHIST}
/gps/hist/inter Lin
