      "Cell \u001b[0;32mIn[13], line 50\u001b[0m, in \u001b[0;36mcheck_edep_src\u001b[0;34m(src_label, root_path, theta_ref, e_dep_ref, res)\u001b[0m\n\u001b[1;32m     46\u001b[0m \u001b[38;5;28mprint\u001b[39m(\u001b[38;5;124mf\u001b[39m\u001b[38;5;124m\"\u001b[39m\u001b[38;5;130;01m\\n\u001b[39;00m\u001b[38;5;124m===== \u001b[39m\u001b[38;5;132;01m{\u001b[39;00msrc_label\u001b[38;5;132;01m}\u001b[39;00m\u001b[38;5;124m =====\u001b[39m\u001b[38;5;124m\"\u001b[39m)\n\u001b[1;32m     47\u001b[0m \u001b[38;5;28;01mfor\u001b[39;00m name, m \u001b[38;5;129;01min\u001b[39;00m [(\u001b[38;5;124m'\u001b[39m\u001b[38;5;124mall\u001b[39m\u001b[38;5;124m'\u001b[39m, np\u001b[38;5;241m.\u001b[39mones(\u001b[38;5;28mlen\u001b[39m(ok), \u001b[38;5;28mbool\u001b[39m)),\n\u001b[1;32m     48\u001b[0m                 (\u001b[38;5;124m'\u001b[39m\u001b[38;5;124mmulti\u001b[39m\u001b[38;5;124m'\u001b[39m, multi),\n\u001b[1;32m     49\u001b[0m                 (\u001b[38;5;124m'\u001b[39m\u001b[38;5;124mmultifirst\u001b[39m\u001b[38;5;124m'\u001b[39m, first_mask)]:\n\u001b[0;32m---> 50\u001b[0m     vm \u001b[38;5;241m=\u001b[39m \u001b[43mm\u001b[49m\u001b[43m \u001b[49m\u001b[38;5;241;43m&\u001b[39;49m\u001b[43m \u001b[49m\u001b[43mvalid\u001b[49m\n\u001b[1;32m     51\u001b[0m     dl \u001b[38;5;241m=\u001b[39m E_loss[vm]; de \u001b[38;5;241m=\u001b[39m E_loc[vm]; d \u001b[38;5;241m=\u001b[39m de \u001b[38;5;241m-\u001b[39m dl\n\u001b[1;32m     52\u001b[0m     \u001b[38;5;28mprint\u001b[39m(\u001b[38;5;124mf\u001b[39m\u001b[38;5;124m\"\u001b[39m\u001b[38;5;124m--- \u001b[39m\u001b[38;5;132;01m{\u001b[39;00msrc_label\u001b[38;5;132;01m}\u001b[39;00m\u001b[38;5;124m [\u001b[39m\u001b[38;5;132;01m{\u001b[39;00mname\u001b[38;5;132;01m}\u001b[39;00m\u001b[38;5;124m]  N=\u001b[39m\u001b[38;5;132;01m{\u001b[39;00mvm\u001b[38;5;241m.\u001b[39msum()\u001b[38;5;132;01m:\u001b[39;00m\u001b[38;5;124m,\u001b[39m\u001b[38;5;132;01m}\u001b[39;00m\u001b[38;5;124m ---\u001b[39m\u001b[38;5;124m\"\u001b[39m)\n",
      "\u001b[0;31mValueError\u001b[0m: operands could not be broadcast together with shapes (1533924,) (856234,) "
     ]
    }
   ],
   "source": [
    "# TEMP: 检查 E_dep 纵轴 = γ能量损失 还是 局部能量沉积 (分析用, 稍后删除)\n",
    "# γ 能量损失 = |p_in| - |p_out|  (gammaCompPrePx/.. 与 gammaCompPx/.., 单位 keV/c, 光子 E=pc)\n",
    "# 局部沉积   = pair_theta_energy 配对的 clusters['energy'] (DBSCAN 簇总沉积)\n",
    "def check_edep_src(src_label, root_path, theta_ref, e_dep_ref, res):\n",
    "    t = uproot.open(str(root_path))['mcTree']\n",
    "    nGC  = np.asarray(t['nGammaComp'].array())\n",
    "    vol  = t['gammaCompVol'].array()\n",
    "    prex = t['gammaCompPrePx'].array(); prey = t['gammaCompPrePy'].array(); prez = t['gammaCompPrePz'].array()\n",
    "    px   = t['gammaCompPx'].array();    py   = t['gammaCompPy'].array();    pz   = t['gammaCompPz'].array()\n",
    "    tm   = t['gammaCompT'].array()\n",
    "\n",
    "    in_tpc = (vol == 'XenonDetector')\n",
    "    cnt = np.asarray(ak.sum(in_tpc, axis=1))\n",
    "\n",
    "    dot = prex*px + prey*py + prez*pz\n",
    "    np_ = np.sqrt(prex**2 + prey**2 + prez**2)   # |p_in| keV/c ≈ 入射 γ 能量\n",
    "    np2 = np.sqrt(px**2 + py**2 + pz**2)         # |p_out| keV/c ≈ 出射 γ 能量\n",
    "    den = np_ * np2\n",
    "    th  = np.degrees(np.arccos(np.clip(\n",
    "        np.asarray(ak.flatten(np.where(den > 0, dot/den, np.nan))), -1, 1)))\n",
    "\n",
    "    cnts_all = np.asarray(nGC)\n",
    "    fevt = np.repeat(np.arange(len(cnts_all)), cnts_all)\n",
    "    fin  = np.asarray(ak.flatten(in_tpc))\n",
    "    E_pre  = np.asarray(ak.flatten(np_))\n",
    "    E_post = np.asarray(ak.flatten(np2))\n",
    "    tm_all = np.asarray(ak.flatten(tm))\n",
    "\n",
    "    ok = fin & np.isfinite(th)\n",
    "    assert len(th[ok]) == len(theta_ref), f\"{src_label}: 记录数不匹配 {len(th[ok])} vs {len(theta_ref)}\"\n",
    "\n",
    "    E_loss = E_pre[ok] - E_post[ok]      # γ 在该 Compton 步的能量损失 (keV)\n",
    "    E_loc  = np.asarray(e_dep_ref)       # 配对簇局部沉积 (keV)\n",
    "    ev_all = fevt[ok]\n",
    "    cnt_rec = cnt[ev_all]\n",
    "    multi = cnt_rec >= 2\n",
    "\n",
    "    # multifirst: 多重事件中每事件时间最早一条\n",
    "    order = np.lexsort((tm_all[ok], ev_all))\n",
    "    s_ev = ev_all[order]\n",
    "    fm_sorted = np.concatenate([[True], s_ev[1:] != s_ev[:-1]])\n",
    "    first_mask = np.zeros(len(ev_all), bool)\n",
    "    first_mask[order[fm_sorted]] = cnt_rec[order[fm_sorted]] >= 2\n",
    "\n",
    "    valid = np.isfinite(E_loc)\n",
    "    print(f\"\\n===== {src_label} =====\")\n",
    "    for name, m in [('all', np.ones(len(ok), bool)),\n",
    "                    ('multi', multi),\n",
    "                    ('multifirst', first_mask)]:\n",
    "        vm = m & valid\n",
    "        dl = E_loss[vm]; de = E_loc[vm]; d = de - dl\n",
    "        print(f\"--- {src_label} [{name}]  N={vm.sum():,} ---\")\n",
    "        print(f\"  γ 能量损失 |p_in|-|p_out|:   median={np.median(dl):8.1f} keV  mean={dl.mean():8.1f}\")\n",
    "        print(f\"  簇局部沉积 cluster energy:   median={np.median(de):8.1f} keV  mean={de.mean():8.1f}\")\n",
    "        print(f\"  差 (簇 - γ损失):             median={np.median(d):+7.1f}  mean={d.mean():+7.1f}\")\n",
    "        print(f\"  簇≈γ损失 (|差|<5 keV):       {100*np.abs(d).mean()<5:.1f}%  -> {100*(np.abs(d)<5).mean():.1f}%\")\n",
    "        print(f\"  簇>γ损失+5 keV (多余沉积):   {100*(d>5).mean():.1f}%\")\n",
    "        print(f\"  簇<γ损失-5 keV:              {100*(d<-5).mean():.1f}%\")\n",
    "        print(f\"  corr(簇, γ损失) = {np.corrcoef(de, dl)[0,1]:.3f}\")\n",
    "        # 典型多余沉积量级 (当 簇>γ损失 时)\n",
    "        extra = d[d > 5]\n",
    "        if len(extra):\n",
    "            print(f\"  多余沉积量 (簇>γ损失): median={np.median(extra):.1f} keV, 占簇能量比 median={100*np.median(extra/de[d>5]):.0f}%\")\n",
    "\n",
    "check_edep_src('Source 1', Path('../result/gamma_source1_1e6_clean.root'), theta_s1, e_s1, res_s1)\n",
    "check_edep_src('Source 2', Path('../result/gamma_source2_1e6_clean.root'), theta_s2, e_s2, res_s2)"
   ]
  }
 ],
