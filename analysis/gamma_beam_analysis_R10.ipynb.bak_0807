   ],
   "source": [
    "# =====================================================================\n",
    "# θ_geo: 双重散射的可观测散射角（关键补充）\n",
    "# ---------------------------------------------------------------------\n",
    "# 物理量: 对每事件 >=2 次 TPC 内 Compton 的事例:\n",
    "#   θ_out = ∠(p_in1, p_out1)  —— 首次散射的真值偏转角 (MC truth, 实验测不到)\n",
    "#   θ_geo = ∠(p_in1, r2-r1)   —— 可观测角: 出射γ方向 ≈ 两次散射位置连线\n",
    "# 说明: 出射γ在两次散射之间近似走直线, 所以 r2-r1 的方向 ≈ p_out1.\n",
    "#       这里用的是 MC 真值顶点位置 (gammaCompX/Y/Z) = \"理想可测\"版本,\n",
    "#       未加探测器位置分辨涂污. 若加探测器响应, 应改用 cluster 位置并加\n",
    "#       ~mm 级位置分辨涂污 (后续可做).\n",
    "# 精度: |θ_geo - θ_out| 逐事例, 报告 mean/median.\n",
    "# =====================================================================\n",
    "\n",
    "def angle_deg(v1, v2):\n",
    "    n1, n2 = np.linalg.norm(v1), np.linalg.norm(v2)\n",
    "    if n1 == 0 or n2 == 0:\n",
    "        return np.nan\n",
    "    return np.degrees(np.arccos(np.clip(np.dot(v1, v2) / (n1 * n2), -1, 1)))\n",
    "\n",
    "def compute_theta_geo(root_path, vol_filter='XenonDetector'):\n",
    "    t = uproot.open(str(root_path))['mcTree']\n",
    "    nGC = np.asarray(t['nGammaComp'].array())\n",
    "    vol = t['gammaCompVol'].array()\n",
    "    X = t['gammaCompX'].array(); Y = t['gammaCompY'].array(); Z = t['gammaCompZ'].array()\n",
    "    prex = t['gammaCompPrePx'].array(); prey = t['gammaCompPrePy'].array(); prez = t['gammaCompPrePz'].array()\n",
    "    px   = t['gammaCompPx'].array();    py   = t['gammaCompPy'].array();    pz   = t['gammaCompPz'].array()\n",
    "    tm   = t['gammaCompT'].array()\n",
    "\n",
    "    in_tpc = vol == vol_filter\n",
    "    cnts = np.asarray(nGC)\n",
    "    fevt = np.repeat(np.arange(len(cnts)), cnts)\n",
    "    fin  = np.asarray(ak.flatten(in_tpc))\n",
    "    ftm  = np.asarray(ak.flatten(tm))\n",
    "    fX = np.asarray(ak.flatten(X)); fY = np.asarray(ak.flatten(Y)); fZ = np.asarray(ak.flatten(Z))\n",
    "    fpx = np.asarray(ak.flatten(px)); fpy = np.asarray(ak.flatten(py)); fpz = np.asarray(ak.flatten(pz))\n",
    "    fpxr = np.asarray(ak.flatten(prex)); fpyr = np.asarray(ak.flatten(prey)); fpzr = np.asarray(ak.flatten(prez))\n",
    "\n",
    "    ok = fin\n",
    "    e = fevt[ok]; tt = ftm[ok]; Xs = fX[ok]; Ys = fY[ok]; Zs = fZ[ok]\n",
    "    ppx = fpx[ok]; ppy = fpy[ok]; ppz = fpz[ok]\n",
    "    rpx = fpxr[ok]; rpy = fpyr[ok]; rpz = fpzr[ok]\n",
    "    order = np.lexsort((tt, e))\n",
    "    e = e[order]; Xs = Xs[order]; Ys = Ys[order]; Zs = Zs[order]\n",
    "    ppx = ppx[order]; ppy = ppy[order]; ppz = ppz[order]\n",
    "    rpx = rpx[order]; rpy = rpy[order]; rpz = rpz[order]\n",
    "\n",
    "    evt_idx = defaultdict(list)\n",
    "    for i in range(len(e)):\n",
    "        evt_idx[e[i]].append(i)\n",
    "    cnt_ev = np.bincount(e)\n",
    "    ev_with2 = [evt for evt in np.unique(e) if cnt_ev[evt] >= 2]\n",
    "\n",
    "    th_out = []; th_geo = []\n",
    "    for evt in ev_with2:\n",
    "        i1, i2 = evt_idx[evt][0], evt_idx[evt][1]\n",
    "        p_in1  = np.array([rpx[i1], rpy[i1], rpz[i1]])\n",
    "        p_out1 = np.array([ppx[i1], ppy[i1], ppz[i1]])\n",
    "        r1 = np.array([Xs[i1], Ys[i1], Zs[i1]])\n",
    "        r2 = np.array([Xs[i2], Ys[i2], Zs[i2]])\n",
    "        th_out.append(angle_deg(p_in1, p_out1))\n",
    "        th_geo.append(angle_deg(p_in1, r2 - r1))\n",
    "    return np.array(th_out), np.array(th_geo)\n",
    "\n",
    "th_out_s1, th_geo_s1 = compute_theta_geo(Path(\"../result/gamma_source1_1e6_clean.root\"))\n",
    "th_out_s2, th_geo_s2 = compute_theta_geo(Path(\"../result/gamma_source2_1e6_clean.root\"))\n",
    "\n",
    "for label, o, g in [(\"Source 1\", th_out_s1, th_geo_s1), (\"Source 2\", th_out_s2, th_geo_s2)]:\n",
    "    d = np.abs(g - o)\n",
    "    print(f\"=== {label} (双簇重建, N={len(o):,}) ===\")\n",
    "    print(f\"  θ_out median={np.nanmedian(o):.1f}° | θ_geo median={np.nanmedian(g):.1f}°\")\n",
    "    print(f\"  |θ_geo-θ_out|: mean={np.nanmean(d):.1f}°, median={np.nanmedian(d):.1f}°\")\n",
    "    m = np.isfinite(o) & np.isfinite(g)\n",
    "    if m.sum() > 2:\n",
    "        print(f\"  相关系数 corr={np.corrcoef(g[m], o[m])[0,1]:.3f}\")\n",
    "\n",
    "# ---- 图: θ_geo vs θ_out（双重散射可观测性）----\n",
    "fig, axes = plt.subplots(1, 2, figsize=(16, 6))\n",
    "for ax, o, g, label, c in [(axes[0], th_out_s1, th_geo_s1, 'Source 1', 'navy'),\n",
    "                            (axes[1], th_out_s2, th_geo_s2, 'Source 2', 'crimson')]:\n",
    "    m = np.isfinite(o) & np.isfinite(g)\n",
    "    h = ax.hist2d(o[m], g[m], bins=(90, 90), range=[[0, 180], [0, 180]], cmap='plasma')\n",
    "    ax.plot([0, 180], [0, 180], 'w--', lw=1.5, alpha=0.8)\n",
    "    ax.set_xlabel(r'$\\theta_{out}$ (truth) [deg]')\n",
    "    ax.set_ylabel(r'$\\theta_{geo}$ = $\\angle(p_{in},r_2-r_1)$ [deg]')\n",
    "    ax.set_title(f'{label}: double-scatter reconstruction (N={m.sum():,})')\n",
    "    plt.colorbar(h[3], ax=ax)\n",
    "plt.tight_layout()\n",
    "plt.savefig('theta_geo_vs_out.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()"
   ]
  },
