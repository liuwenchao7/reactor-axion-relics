figure.dpi : 200
savefig.dpi : 600

font.size : 10
font.family : serif
font.serif : DejaVu Serif
font.weight : normal
mathtext.fontset : dejavuserif
legend.fontsize : 8
legend.fancybox : True
errorbar.capsize : 2

axes.titlesize : 10
axes.labelsize : 9
axes.labelpad : 4
axes.linewidth : 1
axes.unicode_minus : False
axes.formatter.use_mathtext : True
axes.formatter.useoffset : False
axes.prop_cycle : cycler('color', ['000000', '660874', '0033FF', '00561F', 'E5A823', '004990', 'f18d00'])

lines.linewidth : 1
lines.markersize : 3
patch.linewidth : 1
patch.facecolor : white

grid.color : 9F9F9F
grid.linestyle : :
grid.linewidth : 0.4
grid.alpha : 1.0

xtick.labelsize : 9
ytick.labelsize : 9
xtick.major.size : 4
xtick.minor.size : 2
ytick.major.size : 4
ytick.minor.size : 2
xtick.major.width : 1
xtick.minor.width : .7
ytick.major.width : 1
ytick.minor.width : .7
xtick.direction : in
ytick.direction : in

figure.figsize : 3.375, 2.72
figure.constrained_layout.use : True

text.usetex : True
text.latex.preamble : \usepackage[detect-all,locale=DE]{siunitx}
